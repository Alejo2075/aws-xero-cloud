{
  "name": "xero-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Xero: open-source hybrid Lambda-compatible compute runtime",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:aws-disposable": "XERO_AWS_DISPOSABLE=1 vitest run --project aws-disposable",
    "check": "pnpm build && pnpm typecheck:tests && pnpm lint && pnpm test && pnpm test:contracts && pnpm test:integration",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/credential-providers": "^3.0.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.6.6",
    "@xero/aws-identity": "workspace:*",
    "@xero/controller": "workspace:*",
    "@xero/core": "workspace:*",
    "@xero/event-source-sqs": "workspace:*",
    "@xero/execution": "workspace:*",
    "@xero/registry": "workspace:*",
    "@xero/sdk": "workspace:*",
    "@xero/shared": "workspace:*",
    "@xero/specification": "workspace:*",
    "@xero/telemetry": "workspace:*",
    "eslint": "^9.39.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0",
    "yaml": "^2.0.0"
  }
}
