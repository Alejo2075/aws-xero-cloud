{
  "name": "xero-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Xero: open-source hybrid Lambda-compatible compute runtime",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:aws-disposable": "XERO_AWS_DISPOSABLE=1 vitest run --project aws-disposable",
    "check": "pnpm build && pnpm lint && pnpm test && pnpm test:contracts && pnpm test:integration",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
